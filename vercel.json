{
  "rewrites": [
    { "source": "/", "destination": "/viewer/index.html" }
  ],
  "redirects": [
    { "source": "/viewer", "destination": "/", "permanent": true },
    { "source": "/viewer/", "destination": "/", "permanent": true },
    { "source": "/viewer/index.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/data/viz/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
